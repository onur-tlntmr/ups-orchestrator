# /root/srv/env/ups-ci-runner.env on ci-01 (chmod 600), read by the ups-ci-runner quadlet.

# The Gitea instance, as ci-01 reaches it.
GITEA_INSTANCE_URL=

# Needed for the first start only; afterwards the registration lives in the
# ups-ci-runner-data volume. Gitea → repo/org/site Settings → Actions → Runners →
# "Create new runner".
GITEA_RUNNER_REGISTRATION_TOKEN=

GITEA_RUNNER_NAME=ups-ci-runner
