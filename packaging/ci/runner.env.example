# ups-orchestrator Gitea Actions runner — site-specific settings.
#
# install-runner.sh copies this to ~/.config/ups-ci/runner.env (mode 0600), which the
# ups-ci-runner quadlet reads. Fill it in first:
#
#   cp packaging/ci/runner.env.example packaging/ci/runner.env   # git-ignored
#   $EDITOR packaging/ci/runner.env

# REQUIRED. The Gitea instance, as the runner VM reaches it, e.g. https://gitea.example.com
GITEA_INSTANCE_URL=

# REQUIRED for the first start only; afterwards the registration lives in the
# ups-ci-runner-data volume. Gitea → repo/org/site Settings → Actions → Runners →
# "Create new runner".
GITEA_RUNNER_REGISTRATION_TOKEN=

# Name the runner appears under in Gitea.
GITEA_RUNNER_NAME=ups-ci-runner
