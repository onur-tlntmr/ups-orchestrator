# Gitea act_runner as a rootless Podman Quadlet (user unit). install-runner.sh puts this in
# ~/.config/containers/systemd/ and the generator turns it into ups-ci-runner.service.
#
# The runner talks to the user's Podman API socket as if it were Docker, and starts each job as
# a sibling container (rockylinux:10 / fedora:44, see config.yaml) on the same rootless Podman.
[Unit]
Description=Gitea Actions runner for ups-orchestrator
Requires=podman.socket
After=podman.socket

[Container]
ContainerName=ups-ci-runner
Image=docker.io/gitea/act_runner:0.2.13
EnvironmentFile=%h/.config/ups-ci/runner.env
Environment=CONFIG_FILE=/config/config.yaml
Volume=%h/.config/ups-ci/config.yaml:/config/config.yaml:ro
# Registration (.runner) lives here, so the token is only used on the first start.
Volume=ups-ci-runner-data:/data
Volume=%t/podman/podman.sock:/var/run/docker.sock
# The host socket carries the host's SELinux label; without this the runner cannot connect.
SecurityLabelDisable=true

[Service]
Restart=always

[Install]
WantedBy=default.target
