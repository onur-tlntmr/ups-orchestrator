[Unit]
Description=UPS Orchestrator Desktop Agent
After=graphical-session.target network-online.target
Wants=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=/etc/ups-orchestrator/desktop.env

ExecStart=/usr/bin/python3 /usr/share/ups-orchestrator/desktop/app/agent.py
ExecStop=/usr/bin/python3 /usr/share/ups-orchestrator/desktop/app/send_state.py offline

Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
