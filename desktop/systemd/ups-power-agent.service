[Unit]
Description=UPS Power Event Agent
After=network-online.target dbus.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/share/ups-orchestrator/desktop/app/power_agent.py
Restart=always
RestartSec=5
EnvironmentFile=-/etc/ups-orchestrator/desktop.env
Type=simple

# Signal handling for clean exit
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
